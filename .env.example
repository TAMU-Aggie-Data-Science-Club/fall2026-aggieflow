# Copy to .env (git-ignored) and fill in. Never commit .env.
# The agent runs on Gemini (google_genai:gemini-3.5-flash-lite). Use a billed key (credits
# count): on Gemini's free tier Google may use prompts to improve its products.
GOOGLE_API_KEY=
# The eval judges run on Groq (free key at console.groq.com).
GROQ_API_KEY=
# Optional: try another agent model, e.g. google_genai:gemini-3.6-flash or groq:openai/gpt-oss-120b
# AGGIEFLOW_MODEL=google_genai:gemini-3.5-flash-lite

# MongoDB Atlas. Ask a PM for a database user; replace <user> and <password>.
# Leave MONGODB_URI empty to search the local files in data/processed/ instead.
MONGODB_URI=
# MONGODB_URI=mongodb+srv://<user>:<password>@aggieflow.csjybuf.mongodb.net/?appName=aggieflow
MONGODB_DB=aggieflow
# Optional: how Atlas searches: hybrid (default), keyword or vector
# AGGIEFLOW_SEARCH=hybrid
# Optional: reranks hybrid results with Voyage. A free Model API key from Atlas > AI Model APIs.
# VOYAGE_API_KEY=

# Optional: websites allowed to call the API, comma-separated (default: the Vite dev server)
# ALLOWED_ORIGINS=http://localhost:5173

# LangSmith (optional): traces every agent run so you can see tool calls and grade answers.
# Use your own free account at https://smith.langchain.com and make an API key there.
# Each trace is tagged with the model, search mode, git commit and (from eval/score.py) the question id.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=aggieflow
# Running pytest offline with @pytest.mark.langsmith tests? Set this so nothing is sent:
# LANGSMITH_TEST_TRACKING=false
